#!/usr/bin/env bash
# ANSWERS: Milyen tokennel pushol egy ügynök gitje, ha a tulajdonosi token már nincs a gépen? (D4 2. lépcső)
#
# A git credential helper: for https://github.com/<owner>/<repo> it asks the root broker
# (/usr/local/sbin/fleet-github, scripts/root/fleet-github.py) for a one-hour token with the
# `push` role on exactly that repository, and gives it to git as x-access-token. Each agent's
# git config points here, and its sudo line allows only the broker's `token` verb:
#   git config --global --add credential.helper ''      # empties the list: git falls back to the NEXT
#                                                        # helper, so an old one would push with the old token
#   git config --global --add credential.helper /home/marveen/marveen/scripts/git-credential-fleet-github
#   git config --global credential.useHttpPath true      # without it git does not say which repo
#   (and the old repo-level helper removed in every clone; docs/fleet-github.md, step 9)
#   agent-nautilus ALL=(root) NOPASSWD: /usr/local/sbin/fleet-github token *
# Which repositories and roles an agent gets is the broker's root config, not this file.
#
# Anything else (another host, plain http, a store or erase call, no path) prints nothing, so
# git falls back to its next helper or asks. A refused token is said on stderr, never as an
# empty password.
set -uo pipefail
BROKER=/usr/local/sbin/fleet-github   # fixed; the tests replace this one line in a copy
SUDO="sudo -n"                         # fixed; the tests replace this one line in a copy

[ "${1:-}" = get ] || exit 0

protocol="" host="" path=""
# `|| [ -n "$line" ]`: a last line without a newline is still read (the while-read trap)
while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && break
  case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
    path=*) path="${line#path=}" ;;
  esac
done

[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
if [ -z "$path" ]; then
  echo "git-credential-fleet-github: git did not name the repository; set credential.useHttpPath true" >&2
  exit 0
fi
repo="${path%/}"; repo="${repo%.git}"
if [[ ! "$repo" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]{1,100}$ ]]; then
  echo "git-credential-fleet-github: not an owner/repo path: $repo" >&2
  exit 0
fi
if ! tok="$($SUDO "$BROKER" token "$repo" push)"; then
  echo "git-credential-fleet-github: the broker gave no token for $repo" >&2
  exit 0
fi
printf 'username=x-access-token\npassword=%s\n' "$tok"

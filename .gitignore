# Dependencies & build
node_modules
dist/

# Python bytecode cache (e.g. scripts/hooks/__pycache__/*.pyc)
__pycache__/
*.pyc

# Secrets & personal data
# GITIGNENV820: editor backups / copies of .env (.env~, .env.bak, .env.local)
# were not covered -- only the exact name was. Cover every variant, keep the
# tracked example file. *~ catches editor backups of ANY secret-bearing file.
.env
.env.*
!.env.example
*~
store/
workspace/
agents/
reports/
# CLAUDEIGN820: '.claude/' (directory pattern) stopped traversal, so the
# '!.claude/settings.json' negation never fired -- the tracked settings file
# was invisible as untracked and git add refused it on fresh clones.
# '.claude/*' lets git enumerate the first level so the negation can work;
# '*/**/.claude/' keeps nested .claude dirs ignored like before.
.claude/*
!.claude/settings.json
*/**/.claude/
.config/

# Database
*.db
*.db-shm
*.db-wal

# Logs
*.log
*.pid

# Test artifacts
test-results/
.playwright-mcp/

# macOS
.DS_Store

# Generated from template (personal config)
CLAUDE.md

# Agent persona / soul (per-operator personality; never ship upstream)
SOUL.md

# Custom MCP servers and config (user-specific)
mcp-servers/
.mcp.json
mcp-catalog.local.json

# Personal/project-specific docs (not part of the product)
# Old rebuild prompts (keep V3 which is the current one)
REBUILD_PROMPT.md
REBUILD_PROMPT_V2.md
SKOOL_*.md
alkuszokatas_dashboard.md
napindito-prompt.md
scheduled-tasks.json
claudeclaw.log

# Local backup archives from scripts/backup.sh
backups/

# GitNexus knowledge-graph index (local, per-clone; auto-rebuilt by the post-commit hook)
.gitnexus/

# Context-guard runtime handoff document (auto-written by agents at ~90% context;
# per-session state, never source).
HANDOFF.md

# Local one-off artifacts (brainstorm docs, runtime state, rebuild prompts) --
# never committed; ignored to prevent accidental `git add -A` bloat.
DREAM.md
.external-ops-last-run
REBUILD_PROMPT_V3.1.md
.lang

# Main agent's runtime voice config (responseMode/voiceModel). Sub-agents store
# theirs under agents/ (already ignored); the main agent's lives at the repo root
# and is per-install runtime state, never source.
/agent-config.json

# Operator's branded support auto-reply. The shipped support-mail tooling is a
# generic IMAP/SMTP CLI (no operator data); each operator keeps their own
# branded auto-reply here locally. Ignored so it never ships to other installs.
scripts/support-mail/no-support-reply.html

# M365 / Graph mail credentials (client secret, tenant/client IDs). Plaintext
# secret -- never commit. Operator keeps this locally per install.
# GITIGNENV820 same-class gap: exact-name-only patterns left their backup/copy
# variants (name.bak, name.old, name.secret.bak) stageable. Glob the whole family.
marveen-mail-ugyfelkod*
*.secret
*.secret.*
.mail-credentials*

# Python bytecode cache
__pycache__/
*.pyc

# Claude Code Channels runtime config/session dir (sessions, history, tokens,
# plugins, skills). Per-install runtime state -- never source, never commit.
.channels-config/

# EVIDGUARD818: captured output never belongs in the repo (a key leaked from
# .pre-ship-evidence in 2026-07). The secret gate blocks these paths too; this
# rule keeps them from being staged by accident in the first place.
.pre-ship-evidence/
.pre-ship-evidence*
evidence/
.evidence/
transcripts/
.session-capture/

# Local Netlify folder
.netlify

# .agents/: az install sajat termek-/marketing-kontextusa -- KERESKEDELMI ADAT
# (arak, pozicionalas, versenytarsak), SOHA nem mehet a repoba. Tartalom-szintu
# ignore (".agents/*", nem ".agents/"), mert konyvtar-szintu kizaras utan a
# fajl-negacio nem hat (ld. 8811abfd, a .claude/settings.json ugyanigy romlott
# el). A .example vaz viszont kimegy: abbol kap a vevo sajat kontextus-sablont.
.agents/*
!.agents/product-marketing.md.example

# Downloaded Playwright browser binaries -- large, regenerated by
# `playwright install`, never source.
.playwright-browsers/

# Cross-agent handoff documents, briefs, decision logs, one-off payloads.
# Dated, per-engagement operational content -- same class as store/ and
# reports/, never general product documentation.
exchange/

# Acropora Kft's own business/project documentation (Commerce, AI, OS,
# Medusa/UNAS integration, work-order specs, the vision blueprint, dated
# handoffs and briefs) -- customer engagement content, not marveen framework
# documentation. Same technique as .agents/* above: directory-level ignore
# with named exceptions, because a prefix-glob list was tried first and
# measured (git check-ignore --no-index, on the real 88-file list) to miss
# 25 of them -- case mismatches ("acropora-os-funkcio-matrix.md" vs
# "ACROPORA-*") and content-only signals with no matching filename prefix at
# all. This does not retroactively untrack anything: docs/ already carries
# ~54 tracked, general marveen-product files (MIGRATION.md, agent-fleet.md,
# channels.md, ...); this rule only stops the REST from being pulled in by a
# future `git add -A`. The cost this shifts onto the future: a genuinely
# general doc dropped into docs/ without its own `!docs/...` line goes
# quietly untracked -- but that shows up immediately as a `??` line in
# `git status`, unlike the silent opposite direction a leaky prefix-list has.
docs/*
!docs/felmeres-kulon-uid-agensenkent.md
!docs/kulon-uid-0-1-fazis-eredmeny.md
!docs/kulon-uid-2-fazis-proba.md
!docs/kovetetlen-scriptek-atvilagitas-2026-08-18.md
!docs/access-matrix.md
!docs/futtat.md
!docs/fleet-gate.md
!docs/fleet-pane.md
!docs/fleet-pane-telepites.md
!docs/fleet-github.md
!docs/acropora-restore-probe.md
!docs/task-handoff.md
!docs/task-usage.md
!docs/FIGMA-MAP.md

# Auto-regenerated by fleet-bootstrap.sh from the CURRENT agent list --
# per-install state, not source. The /etc copy is what actually matters and
# is outside the repo anyway.
scripts/sudoers-is-paired

# Dated manual backup copies (name.bak-YYYYMMDD-HHMMSS). One-off snapshots
# made by hand before an edit, never source -- delete the file itself; this
# only stops the NEXT one from being stageable.
*.bak-[0-9]*

# futtat (scripts/futtat.py): the full command logs AND their summaries. Runtime
# data, masked but still project data: `*.log` alone would leave the
# .summary.json files stageable.
logs/

# deploy executor build output (deploy-executor/tsconfig.build.json)
/out/

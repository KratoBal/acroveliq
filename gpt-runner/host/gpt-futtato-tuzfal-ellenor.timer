# Runs gpt-futtato-tuzfal-ellenor.service one minute after boot and then every minute. A named
# automatism instead of a manual step (Balázs's standing order, 2026-10-13).
[Unit]
Description=GPT-futtato: a host-tuzfal percenkenti ellenorzese

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=5s
Unit=gpt-futtato-tuzfal-ellenor.service

[Install]
WantedBy=timers.target
